# 가계부 웹 서버. 토스 키가 없다 — 매매 키는 myhome-invest-*.service의 trader.env에만 있다.
#
# 설치 (myhome VM, Ubuntu 24.04 minimal):
#   useradd --system --home /var/lib/myhome-web --shell /usr/sbin/nologin myhome-web
#   install -m 0755 myhome /opt/myhome/myhome
#   install -m 0640 -o root -g myhome-web web.env /etc/myhome/web.env
#   cp deploy/home/systemd/*.service deploy/home/systemd/*.timer /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now myhome.service
#
# web.env: DATABASE_URL(웹 역할 — 매매 테이블은 읽기만), MIGRATE_ON_START=false, CF_ACCESS_TEAM_DOMAIN / CF_ACCESS_AUD / ALLOWED_EMAILS(docs/ACCESS_SETUP.md), HTTP_ADDR=127.0.0.1:8080(Tunnel), PARSER_PACKAGES …
# 마이그레이션은 배포 스크립트가 소유자 역할로 따로 돌린다 (deploy/home/postgres-roles.sql)
[Unit]
Description=myhome 가계부 웹 서버
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=myhome-web
EnvironmentFile=/etc/myhome/web.env
# 끼니 사진: /var/lib/myhome/meal_photos (systemd가 myhome-web 소유로 만든다). 백업은 myhome-backup이 버킷 photos/로
StateDirectory=myhome
StateDirectoryMode=0750
Environment=MEAL_PHOTO_DIR=/var/lib/myhome/meal_photos
ExecStart=/opt/myhome/myhome serve
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=200M

[Install]
WantedBy=multi-user.target
