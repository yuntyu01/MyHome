# 자동매매 실패 알림. 실패한 invest 유닛의 OnFailure=가 부른다 (%i = 실패한 유닛 이름).
# 메일 대신 invest_alerts에 한 줄을 쓰고, 앱이 주기 작업에서 읽어 폰 알림을 띄운다(토스를 부르지 않는다).
[Unit]
Description=myhome 자동매매 실패 알림 (%i)
After=postgresql.service

[Service]
Type=oneshot
User=myhome-trader
EnvironmentFile=/etc/myhome/trader.env
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
TimeoutStartSec=2min
ExecStart=/opt/myhome/myhome invest alert --unit %i
