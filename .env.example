# 이 파일을 .env로 복사해서 값을 채운다. .env는 절대 커밋하지 않는다.
# 모든 서버 설정은 환경변수로 받는다. 자세한 설명은 docs/DEPLOY.md.

# --- 서버 ---
HTTP_ADDR=:8080
LOG_LEVEL=info
# 로컬 docker-compose의 postgres 기준
DATABASE_URL=postgres://myhome:myhome@localhost:5432/myhome?sslmode=disable
MIGRATE_ON_START=true

# --- 수집 API 보호 ---
MAX_BODY_BYTES=65536
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=30
# 리버스 프록시(kodeploy 등) 뒤에서는 true
TRUST_PROXY_HEADERS=false
# 비상용 CLI 토큰 발급(myhome token issue). 카카오 로그인 설정 후 false 권장
CLI_TOKEN_ISSUE_ENABLED=true

# --- 파서 ---
# 패키지명 → 파서 매핑. 앱 "최근 알림" 화면에서 실제 패키지명을 확인해서 넣는다(docs/PARSERS.md).
# 형식: 이름=패키지1,패키지2;이름2=패키지3   (kb, toss는 전용 파서, 그 외 이름은 범용 파서 + source 이름)
# 아래는 확인되지 않은 예시다. 실제 값으로 바꿀 것.
# PARSER_PACKAGES=kb=com.example.kbpay;toss=com.example.toss;kakaopay=com.example.kakaopay
PARSER_PACKAGES=

# --- 카카오 로그인 (docs/KAKAO_SETUP.md) ---
APP_ENV=production
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://money.example.com/auth/kakao/callback
# 카카오 앱 ID(숫자). 설정하면 다른 앱의 카카오 토큰으로 기기 토큰을 받지 못한다.
KAKAO_APP_ID=
# 허용할 본인 카카오 회원번호(쉼표 구분)
ALLOWED_KAKAO_IDS=
# 웹 세션 쿠키. 로컬 http 개발에서만 false
COOKIE_SECURE=true
SESSION_TTL=720h
# 로컬 개발용 로그인 우회(APP_ENV=development에서만 동작). 운영에서는 비워 둘 것
# DEV_LOGIN_KAKAO_ID=

# --- 테스트 ---
TEST_DATABASE_URL=postgres://myhome:myhome@localhost:5432/myhome_test?sslmode=disable
