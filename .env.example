# 이 파일을 .env로 복사해서 값을 채운다. .env는 절대 커밋하지 않는다.
# 모든 서버 설정은 환경변수로 받는다. 자세한 설명은 docs/DEPLOY.md.

# --- 서버 ---
HTTP_ADDR=:8080
LOG_LEVEL=info
# 로컬 docker-compose의 postgres 기준
DATABASE_URL=postgres://myhome:myhome@localhost:5432/myhome?sslmode=disable
MIGRATE_ON_START=true

# --- 수집 API 보호 ---
MAX_BODY_BYTES=65536
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=30
# 리버스 프록시(Cloudflare Tunnel, kodeploy 등) 뒤에서는 true
TRUST_PROXY_HEADERS=false
# 비상용 CLI 토큰 발급(myhome token issue). 앱 연결(/app/link)을 확인한 뒤 false 권장
CLI_TOKEN_ISSUE_ENABLED=true

# --- 파서 ---
# 패키지명 → 파서 매핑. 앱 "최근 알림" 화면에서 실제 패키지명을 확인해서 넣는다(docs/PARSERS.md).
# 형식: 이름=패키지1,패키지2;이름2=패키지3   (kb, toss는 전용 파서, 그 외 이름은 범용 파서 + source 이름)
# 아래는 확인되지 않은 예시다. 실제 값으로 바꿀 것.
# PARSER_PACKAGES=kb=com.example.kbpay;toss=com.example.toss;kakaopay=com.example.kakaopay
PARSER_PACKAGES=

# --- 웹 로그인: Cloudflare Access + 구글 (docs/ACCESS_SETUP.md) ---
# production(기본)에서는 아래 세 값(CF_ACCESS_TEAM_DOMAIN, CF_ACCESS_AUD, ALLOWED_EMAILS)이 없으면 서버가 시작하지 않는다
APP_ENV=production
# Zero Trust 팀 도메인(https:// 있어도 됨)
CF_ACCESS_TEAM_DOMAIN=
# 웹 Access 애플리케이션의 AUD 태그
CF_ACCESS_AUD=
# 허용할 구글 이메일(쉼표 구분, 대소문자 무시). Access 정책과 같은 값
ALLOWED_EMAILS=
# 서버 세션 쿠키(CSRF용). 로컬 http 개발에서만 false
COOKIE_SECURE=true
SESSION_TTL=720h
# 로컬 개발용 로그인 우회(APP_ENV=development + Access 미설정일 때만, ALLOWED_EMAILS에 있어야 함). 운영에서는 비워 둘 것
# DEV_LOGIN_EMAIL=

# --- 건강 (/v1/health, 핏두잉 이식) ---
# 끼니 사진 분석과 가계부 AI 분류 추천: mock | gemini. 비우면 GEMINI_API_KEY가 있을 때 gemini, 없을 때 mock(키 없이 고정 결과)
AI_PROVIDER=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# 가계부 AI 분류 추천: on(기본) | off. 규칙이 없는 지출의 가맹점 이름만 위 AI로 묻는다(mock이면 작은 낱말 표로 고정 추천)
AI_CLASSIFY=on
# 바코드 → 제품 영양성분. 두 키가 다 있어야 켜진다
# 끼니 사진 저장 폴더(비우면 저장 안 함)
MEAL_PHOTO_DIR=
FOODSAFETY_API_KEY=
DATA_GO_KR_API_KEY=

# --- 테스트 ---
TEST_DATABASE_URL=postgres://myhome:myhome@localhost:5432/myhome_test?sslmode=disable
